<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context="com.cursosvirtuales.app.cursos.CreateCourseActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/titulo_crear_curso"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_nombre_curso" />

        <EditText
            android:id="@+id/et_nombre_curso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_nombre_curso"
            android:inputType="textCapSentences"
            android:maxLength="80" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_descripcion_curso" />

        <EditText
            android:id="@+id/et_descripcion_curso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="top|start"
            android:hint="@string/hint_descripcion_curso"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="300"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_fecha_inicio" />

        <Button
            android:id="@+id/btn_fecha_inicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_seleccionar_fecha" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_fecha_fin" />

        <Button
            android:id="@+id/btn_fecha_fin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_seleccionar_fecha" />

        <TextView
            android:id="@+id/tv_error_curso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#C0392B"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="El nombre del curso es obligatorio."
            tools:visibility="visible" />

        <Button
            android:id="@+id/btn_guardar_curso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_crear_curso" />

    </LinearLayout>

</ScrollView>
