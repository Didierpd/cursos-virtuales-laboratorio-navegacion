<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:padding="16dp">
    <TextView android:id="@+id/cl_to_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/cl_to_label" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/cl_email_address" />
    <EditText android:id="@+id/cl_email_address" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:hint="@string/cl_email_hint" android:inputType="textEmailAddress"
        android:autofillHints="emailAddress" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/cl_to_label" app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_subject" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="@string/cl_subject_hint" android:inputType="textCapSentences"
        app:layout_constraintTop_toBottomOf="@id/cl_email_address" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_message" android:layout_width="0dp" android:layout_height="0dp"
        android:hint="@string/cl_message_hint" android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine" android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/cl_subject" app:layout_constraintBottom_toTopOf="@id/cl_send"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_send" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/cl_send" android:textAllCaps="false" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
