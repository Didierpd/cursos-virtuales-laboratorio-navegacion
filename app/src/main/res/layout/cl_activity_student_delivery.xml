<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:padding="20dp" android:background="@color/cl_surface">
    <TextView android:id="@+id/cl_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/cl_delivery_title" android:textSize="26sp" android:textStyle="bold"
        android:textColor="@color/cl_text_primary" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/cl_help" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/cl_delivery_help"
        app:layout_constraintTop_toBottomOf="@id/cl_title" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_student_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="@string/cl_student_name_hint" android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/cl_help" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_student_code" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="@string/cl_student_code_hint" android:inputType="text" app:layout_constraintTop_toBottomOf="@id/cl_student_name"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_student_email" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="@string/cl_student_email_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress"
        app:layout_constraintTop_toBottomOf="@id/cl_student_code" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_course" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="@string/cl_course_hint" android:inputType="textCapWords" app:layout_constraintTop_toBottomOf="@id/cl_student_email"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_activity_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="@string/cl_activity_hint" android:inputType="textCapSentences" app:layout_constraintTop_toBottomOf="@id/cl_course"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_repository_url" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="@string/cl_link_hint" android:inputType="textUri" app:layout_constraintTop_toBottomOf="@id/cl_activity_name"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/cl_comments" android:layout_width="0dp" android:layout_height="0dp"
        android:hint="@string/cl_comments_hint" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine"
        android:minHeight="80dp" android:padding="8dp" app:layout_constraintTop_toBottomOf="@id/cl_repository_url"
        app:layout_constraintBottom_toTopOf="@id/cl_register" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_register" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/cl_register_delivery" android:textAllCaps="false" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
