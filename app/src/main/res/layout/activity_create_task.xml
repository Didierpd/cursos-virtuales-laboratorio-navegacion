<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context="com.cursosvirtuales.app.cursos.CreateTaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/titulo_crear_tarea"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_titulo_tarea" />

        <EditText
            android:id="@+id/et_titulo_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_titulo_tarea"
            android:inputType="textCapSentences"
            android:maxLength="80" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_enunciado_tarea" />

        <EditText
            android:id="@+id/et_enunciado_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="top|start"
            android:hint="@string/hint_enunciado_tarea"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_fecha_limite_tarea" />

        <Button
            android:id="@+id/btn_fecha_limite_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_seleccionar_fecha" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_puntaje_tarea" />

        <EditText
            android:id="@+id/et_puntaje_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_puntaje_tarea"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:id="@+id/tv_error_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#C0392B"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="El titulo de la tarea es obligatorio."
            tools:visibility="visible" />

        <Button
            android:id="@+id/btn_guardar_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_crear_tarea" />

    </LinearLayout>

</ScrollView>
