<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvRolePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMisCursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/titulo_mis_cursos"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCursosDisponibles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/titulo_cursos_disponibles"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis calificaciones"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServiciosRest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Servicios REST" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Talleres del curso" android:textStyle="bold" android:textSize="18sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEncomiendas" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Encomiendas · SQLite" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLayouts" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Interfaces y formularios" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDemo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Cargar ejemplos de presentación" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_go_profile" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_logout" />

</LinearLayout>
</ScrollView>
