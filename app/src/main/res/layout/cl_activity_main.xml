<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp" android:background="@color/cl_surface">

    <TextView android:id="@+id/cl_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/cl_app_name" android:textSize="26sp" android:textStyle="bold"
        android:textColor="@color/cl_text_primary" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/cl_subtitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/cl_lab_subtitle" android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/cl_title" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_exercise1" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/cl_exercise_1" android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/cl_subtitle" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_exercise2" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/cl_exercise_2" android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/cl_exercise1" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_exercise3" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/cl_exercise_3" android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/cl_exercise2" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_exercise4" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/cl_exercise_4" android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/cl_exercise3" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_email" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/cl_email_form" android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/cl_exercise4" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/cl_delivery" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/cl_delivery_form" android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/cl_email" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
