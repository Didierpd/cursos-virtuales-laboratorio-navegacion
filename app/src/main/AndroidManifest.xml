<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CursosVirtuales">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RestServicesActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.ProfileActivity" android:exported="false" />
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:label="@string/register_title" />

        <activity
            android:name=".cursos.CourseListActivity"
            android:exported="false"
            android:label="@string/titulo_mis_cursos" />
        <activity
            android:name=".cursos.CreateCourseActivity"
            android:exported="false"
            android:parentActivityName=".cursos.CourseListActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".cursos.AvailableCoursesActivity"
            android:exported="false"
            android:label="@string/titulo_cursos_disponibles" />
        <activity
            android:name=".cursos.CourseDetailActivity"
            android:exported="false"
            android:parentActivityName=".cursos.CourseListActivity" />
        <activity
            android:name=".cursos.UnitListActivity"
            android:exported="false"
            android:label="@string/titulo_unidades_curso"
            android:parentActivityName=".cursos.CourseDetailActivity" />
        <activity
            android:name=".cursos.CreateUnitActivity"
            android:exported="false"
            android:parentActivityName=".cursos.UnitListActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".cursos.TaskListActivity"
            android:exported="false"
            android:label="@string/titulo_tareas_curso"
            android:parentActivityName=".cursos.CourseDetailActivity" />
        <activity
            android:name=".cursos.CreateTaskActivity"
            android:exported="false"
            android:parentActivityName=".cursos.TaskListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".cursos.StudentCoursesActivity" android:exported="false" />
        <activity android:name=".cursos.TaskDetailActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".cursos.GradebookActivity" android:exported="false" />
        <activity android:name=".cursos.LaboratoryActivity" android:exported="false" />
        <activity android:name=".cursos.CreateLaboratoryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".talleres.layouts.LayoutLabActivity" android:exported="false" android:label="Interfaces y formularios" android:theme="@style/Theme.CursosVirtuales.Workshop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".talleres.layouts.EmailActivity" android:exported="false" android:label="Borrador de correo" android:theme="@style/Theme.CursosVirtuales.Workshop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".talleres.layouts.StudentDeliveryActivity" android:exported="false" android:label="Entrega de actividad" android:theme="@style/Theme.CursosVirtuales.Workshop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".talleres.layouts.ExerciseActivity" android:exported="false" android:label="Ejercicios ConstraintLayout" android:theme="@style/Theme.CursosVirtuales.Workshop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".talleres.encomiendas.RegistroActivity" android:exported="false" android:label="Registrar encomienda" android:theme="@style/Theme.CursosVirtuales.Workshop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".talleres.encomiendas.ConsultaActivity" android:exported="false" android:label="Consultar encomiendas" android:theme="@style/Theme.CursosVirtuales.Workshop" android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
