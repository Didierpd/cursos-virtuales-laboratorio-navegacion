<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Campus · Gestión académica</title><link rel="stylesheet" href="<c:url value='/assets/academica.css'/>"></head>
<body><div class="shell"><aside class="sidebar"><div class="brand">C<span>Campus</span></div><p>GESTIÓN ACADÉMICA</p><nav><a href="#estudiantes">01 · Estudiantes</a><a href="#cursos">02 · Cursos</a><a href="#inscripciones">03 · Inscripciones</a></nav><div class="side-note">Organiza tus cursos.<br>Conecta el aprendizaje.</div></aside>
<main><header><span class="eyebrow">ESPACIO ACADÉMICO</span><h1>Todo empieza con un curso.</h1><p>Administra estudiantes, organiza la oferta y gestiona sus inscripciones.</p></header>
<c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty mensaje}"><div class="alert success" role="status"><c:out value="${mensaje}"/></div></c:if>
<section id="estudiantes"><div class="section-title"><h2>Estudiantes</h2><span>Tu comunidad académica</span></div>
<div class="card"><h3>Registrar estudiante</h3><form method="post" action="<c:url value='/gestion'/>">
<input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardarEstudiante">
<div class="form-grid"><label>Código<input name="codigo" maxlength="20" required placeholder="EST-001"></label><label>Nombre completo<input name="nombre" maxlength="100" required placeholder="Nombre y apellido"></label><label>Correo<input name="correo" maxlength="150" type="email" required placeholder="estudiante@ejemplo.com"></label></div><button>Registrar estudiante</button></form></div>
<c:if test="${empty estudiantes}"><p class="empty">Aún no hay estudiantes. Registra el primero para comenzar.</p></c:if>
<div class="records"><c:forEach items="${estudiantes}" var="e"><article class="record" data-estudiante="<c:out value='${e.codigo}'/>"><div class="record-head"><span class="code"><c:out value="${e.codigo}"/></span><h3><c:out value="${e.nombre}"/></h3></div><p class="muted"><c:out value="${e.correo}"/></p><div class="tags"><c:forEach items="${e.cursos}" var="c"><span><c:out value="${c.codigo}"/> · <c:out value="${c.nombre}"/></span></c:forEach><c:if test="${empty e.cursos}"><span>Sin cursos inscritos</span></c:if></div>
<details><summary>Editar o eliminar</summary><form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardarEstudiante"><input type="hidden" name="editar" value="true"><input type="hidden" name="codigo" value="<c:out value='${e.codigo}'/>"><label>Nombre<input name="nombre" value="<c:out value='${e.nombre}'/>" maxlength="100" required></label><label>Correo<input name="correo" value="<c:out value='${e.correo}'/>" type="email" maxlength="150" required></label><button>Guardar cambios</button></form>
<form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="eliminarEstudiante"><input type="hidden" name="codigo" value="<c:out value='${e.codigo}'/>"><button class="danger">Eliminar estudiante sin inscripciones</button></form></details></article></c:forEach></div></section>
<section id="cursos"><div class="section-title"><h2>Cursos</h2><span>Planea la oferta académica</span></div><div class="card"><h3>Crear curso</h3><form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardarCurso"><div class="form-grid"><label>Código<input name="codigo" maxlength="20" required placeholder="CUR-001"></label><label class="wide">Nombre del curso<input name="nombre" maxlength="100" required placeholder="Arquitectura de software"></label><label>Créditos<input name="creditos" type="number" min="1" max="30" value="3" required></label><label>Semestre<input name="semestre" type="number" min="1" max="20" value="1" required></label><label>Estudiantes admitidos (cupo)<input name="cupo" type="number" min="1" max="1000" value="30" required></label></div><button>Crear curso</button></form></div>
<c:if test="${empty cursos}"><p class="empty">Crea un curso para habilitar las inscripciones.</p></c:if><div class="records"><c:forEach items="${cursos}" var="c"><article class="record" data-curso="<c:out value='${c.codigo}'/>"><div class="record-head"><span class="code"><c:out value="${c.codigo}"/></span><h3><c:out value="${c.nombre}"/></h3></div><p class="muted">${c.creditos} créditos · Semestre ${c.semestre} · ${c.estudiantes.size()} / ${c.estudiantesAdmitidos} inscritos</p><div class="tags"><c:forEach items="${c.estudiantes}" var="e"><span><c:out value="${e.codigo}"/> · <c:out value="${e.nombre}"/></span></c:forEach></div>
<details><summary>Editar o eliminar</summary><form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardarCurso"><input type="hidden" name="editar" value="true"><input type="hidden" name="codigo" value="<c:out value='${c.codigo}'/>"><label>Nombre<input name="nombre" value="<c:out value='${c.nombre}'/>" maxlength="100" required></label><div class="form-grid"><label>Créditos<input name="creditos" type="number" min="1" max="30" value="${c.creditos}" required></label><label>Semestre<input name="semestre" type="number" min="1" max="20" value="${c.semestre}" required></label><label>Cupo<input name="cupo" type="number" min="1" max="1000" value="${c.estudiantesAdmitidos}" required></label></div><button>Guardar cambios</button></form><form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="eliminarCurso"><input type="hidden" name="codigo" value="<c:out value='${c.codigo}'/>"><button class="danger">Eliminar curso sin inscripciones</button></form></details></article></c:forEach></div></section>
<section id="inscripciones"><div class="section-title"><h2>Inscripciones</h2><span>Un estudiante, múltiples caminos</span></div><div class="card"><h3>Relacionar estudiante y curso</h3><p class="muted">Cada estudiante puede tomar varios cursos. Cada curso admite varios estudiantes, hasta completar su cupo.</p><c:choose><c:when test="${empty estudiantes or empty cursos}"><p>Primero registra al menos un estudiante y un curso.</p></c:when><c:otherwise><form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="inscribir"><div class="form-grid two"><label>Estudiante<select name="estudiante" required><c:forEach items="${estudiantes}" var="e"><option value="<c:out value='${e.codigo}'/>"><c:out value="${e.codigo}"/> · <c:out value="${e.nombre}"/></option></c:forEach></select></label><label>Curso<select name="curso" required><c:forEach items="${cursos}" var="c"><option value="<c:out value='${c.codigo}'/>"><c:out value="${c.codigo}"/> · <c:out value="${c.nombre}"/></option></c:forEach></select></label></div><button>Confirmar inscripción</button></form></c:otherwise></c:choose></div>
<div class="enrollments"><c:forEach items="${estudiantes}" var="e"><c:forEach items="${e.cursos}" var="c"><div class="enrollment" data-inscripcion="<c:out value='${e.codigo}'/>:<c:out value='${c.codigo}'/>"><div><strong><c:out value="${e.nombre}"/></strong><p><c:out value="${c.nombre}"/> · <c:out value="${c.codigo}"/></p></div><form method="post" action="<c:url value='/gestion'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="retirar"><input type="hidden" name="estudiante" value="<c:out value='${e.codigo}'/>"><input type="hidden" name="curso" value="<c:out value='${c.codigo}'/>"><button class="secondary">Retirar</button></form></div></c:forEach></c:forEach></div></section><footer>Campus · Laboratorio de persistencia académica</footer></main></div></body></html>
