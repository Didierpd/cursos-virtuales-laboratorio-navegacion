<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>co.edu.unipiloto</groupId>
        <artifactId>GestionAcademicaJPA</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>academica-ear</artifactId>
    <packaging>ear</packaging>
    <name>Gestión académica · Aplicación empresarial EAR</name>
    <dependencies>
        <dependency>
            <groupId>co.edu.unipiloto</groupId>
            <artifactId>academica-ejb</artifactId>
            <version>${project.version}</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>co.edu.unipiloto</groupId>
            <artifactId>academica-web</artifactId>
            <version>${project.version}</version>
            <type>war</type>
        </dependency>
    </dependencies>
    <build>
        <finalName>GestionAcademicaJPA</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <configuration>
                    <version>7</version>
                    <modules>
                        <ejbModule>
                            <groupId>co.edu.unipiloto</groupId>
                            <artifactId>academica-ejb</artifactId>
                            <bundleFileName>academica-ejb.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>co.edu.unipiloto</groupId>
                            <artifactId>academica-web</artifactId>
                            <bundleFileName>academica-web.war</bundleFileName>
                            <contextRoot>/academica</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
